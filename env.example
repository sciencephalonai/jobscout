# ─── Adzuna Job Search API ────────────────────────────────────────────────────
# Register at https://developer.adzuna.com/ to obtain credentials.
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ─── DeepSeek (job enrichment LLM via OpenAI-compatible client) ───────────────
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ─── NVIDIA NIM (optional OpenAI-compatible alternative to DeepSeek) ─────────
# Set LLM_PROVIDER=nvidia, then provide a newly generated NVIDIA API key. Never
# commit or paste a real key into source code or shared chat.
LLM_PROVIDER=deepseek
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=z-ai/glm-5.2

# ─── Google Gemini (embeddings) ──────────────────────────────────────────────
# Used for generating job description embeddings via the google-genai (Gemini
# API) SDK. NOTE: the spec's "text-embedding-005" is a *Vertex* model name and
# is NOT served by the Gemini API. With a Gemini API key, use
# gemini-embedding-001 (3072-dim) or text-embedding-004.
GOOGLE_API_KEY=your_google_api_key_here
EMBED_MODEL=gemini-embedding-001

# ─── OpenAI (fallback / additional LLM usage) ────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ─── Weaviate Vector Store ────────────────────────────────────────────────────
# Local Docker instance (default):
WEAVIATE_URL=http://localhost:8080
# Weaviate Cloud (WCD): set BOTH to use a managed cluster instead of local.
# CLUSTER_URL is the REST endpoint (scheme optional). When both are set, the
# store connects via connect_to_weaviate_cloud and WEAVIATE_URL is ignored.
WEAVIATE_CLUSTER_URL=
WEAVIATE_API_KEY=

# ─── Enrichment Pipeline ──────────────────────────────────────────────────────
# Number of jobs processed per enrichment batch (LLM calls are batched).
ENRICH_BATCH_SIZE=20

# ─── Ingest Scheduler ─────────────────────────────────────────────────────────
# Daily auto-refresh. OFF by default — a daily crawl can exhaust the Gemini free
# embedding tier (1,000/day). Enable via Settings in the UI or set here.
SCHEDULER_ENABLED=false
# Local hour (0-23) at which the daily refresh runs when scheduler is enabled.
SCHEDULER_HOUR=6
# How often the ingest job runs (in hours).
INGEST_INTERVAL_HOURS=6

# ─── Embedding budget ─────────────────────────────────────────────────────────
# Max embeds per ingest/refresh run. Gemini free tier = 1,000 embeds/day, SHARED
# with search + resume-match — so this reserves ~half the day's quota for search.
EMBED_DAILY_BUDGET=500

# ─── Storage ──────────────────────────────────────────────────────────────────
# File path for the DuckDB relational store.
RELATIONAL_DB_PATH=./jobscout.duckdb

# ─── Resume writing (local, audited DOCX tailoring) ──────────────────────────
# This private toolkit is intentionally separate from the app: it provides the
# Resume generator: "latex" (default) builds a PDF + DOCX from the profile's own
# content with AI-reduction metrics (needs system xelatex + pandoc); "node" uses the
# private DOCX toolkit below. See docs/configuration.md.
TAILOR_ENGINE=latex
# LaTeX engine template dir; blank = bundled backend/jobscout/resume_templates/.
RESUME_TEMPLATE_DIR=
# canonical facts, presets, a single DOCX builder, and an audit gate.
# Point this at your own private resume-writing toolkit (only the "node" engine).
RESUME_WRITER_DIR=
TAILORED_RESUME_STORAGE_DIR=./data/tailored-resumes
# Leave blank to use the toolkit/user-level Node dependency lookup.
RESUME_WRITER_NODE_PATH=

# ─── Weaviate backup ──────────────────────────────────────────────────────────
# When true, a Weaviate backup (scripts/export_weaviate.py -> data/weaviate_export.jsonl.gz)
# runs automatically at the end of each ingest so the local export stays fresh.
# Pure $0 download (no embedding). Off by default — back up on demand otherwise.
EXPORT_AFTER_INGEST=false

# ─── Agent ────────────────────────────────────────────────────────────────────
# Maximum retry attempts for the enrichment / agentic loop before giving up.
AGENT_MAX_ATTEMPTS=3

# ─── USAJobs (opt-in government source) ───────────────────────────────────────
# Free key from https://developer.usajobs.gov (email = the account you register).
# Also flip `usajobs: enabled: true` in sources.yaml. Federal roles skew
# citizenship-required; those are dropped before any enrichment spend.
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ─── Ingestion parallelism ────────────────────────────────────────────────────
# Source fetches run in parallel (one HTTP client per source; per-domain rate
# limits still respected). 1 = sequential legacy behavior.
INGEST_FETCH_WORKERS=6

# ─── Identity (Auth0) + hosting (Supabase) ────────────────────────────────────
# Blank = single local user, no external services (today's local behavior).
# Mirrors the Leelaa setup. See docs/auth-and-hosting.md for the full walkthrough.
# Setting AUTH0_DOMAIN turns on real login (JWT verified at api/deps.current_user_id).
AUTH0_DOMAIN=                      # e.g. dev-xyz.us.auth0.com
AUTH0_AUDIENCE=                    # the Auth0 API identifier, e.g. https://api.jobscout.app
REQUIRE_AUTH=false                 # true → 401 without a valid token (once Auth0 is set)

# Supabase Postgres (Phase 2) — when set, replaces DuckDB as the relational store.
DATABASE_URL=                      # postgresql://…  (or use SUPABASE_DB_URL below)
SUPABASE_DB_URL=                   # Supabase connection string (copied into DATABASE_URL if that's blank)

# Supabase Storage (Phase 3) — when url+key+bucket are set, files go to Supabase.
SUPABASE_URL=                      # https://<ref>.supabase.co
SUPABASE_SERVICE_KEY=              # service-role key (server-side only; never exposed to the browser)
SUPABASE_STORAGE_BUCKET=jobscout-files
STORAGE_BACKEND=auto               # auto | local | supabase
