# Frontend (Vite) env. Copy to frontend/.env and fill in to enable Auth0 login.
# Leave blank to run the SPA unauthenticated (local dev) — identical to before.
# These MUST match the Auth0 SPA application + API you set up (see docs/auth-and-hosting.md).
VITE_AUTH0_DOMAIN=          # e.g. dev-xyz.us.auth0.com
VITE_AUTH0_CLIENT_ID=       # the Auth0 SPA application's Client ID
VITE_AUTH0_AUDIENCE=        # the Auth0 API identifier (same as backend AUTH0_AUDIENCE)
